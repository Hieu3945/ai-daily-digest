# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Gemini API (get a free key at https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram bot (create one with @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets: the service account key, either the JSON pasted as one line or a path to
# the downloaded .json file (keep that file outside the repo), and the sheet ID from its URL
GOOGLE_CREDENTIALS=
SHEET_ID=
